      "fast-uri@>=3.1.3 <3.1.9": ">=3.1.9",
      "@modelcontextprotocol/sdk@>=1.10.0 <1.30.1": ">=1.30.1",
      "@hono/node-server@>=1.19.10 <2.1.3": ">=2.1.3",

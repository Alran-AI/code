#!/bin/sh
set -eu
runtime_executable=${__MAVIS_ALRAN_TOOLS_RUNTIME_EXECUTABLE:-}
if [ -z "$runtime_executable" ]; then
  echo "Alran alran-tools runtime is unavailable. Restart Alran." >&2
  exit 1
fi
alran_tools_bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$runtime_executable" "$alran_tools_bin_dir/../alran-tools.js" "$@"
